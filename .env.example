# Променливи на СЪРВЪРА за backend-а (файл .env до docker-compose.yml; локално .env.local).
# Копирай като .env и попълни реалните стойности. Реалните стойности НЕ се пазят в git.
# Задължителни са отбелязаните с [задължително]; останалите включват отделна функционалност.

# ---------- База и сървър ----------
# [задължително] DO Managed Postgres (25060, sslmode=require); локално: postgresql://user:pass@localhost:5432/cortanasoft?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/cortanasoft?sslmode=require
# [задължително] Порт на NestJS вътре в контейнера (nginx проксира към него)
PORT=3001
# [задължително] Адресът на фронтенда — CORS и линкове в имейли
FRONTEND_URL=https://cortanasoft.com
# production | development — в production грешките към клиента са общи (без вътрешни детайли)
NODE_ENV=production
# Попълва се от Docker build (git SHA) — за /api/health; не е нужно ръчно
# APP_VERSION=

# ---------- Сигурност ----------
# [задължително] Подписва JWT cookie-то access_token. СЪЩАТА стойност трябва да е и във frontend .env
JWT_SECRET=change-me-long-random-string
# [задължително в production] Шифрова тайни в базата (Anthropic ключове по фирма, Еконт/Спиди
# пароли, 2FA ключове, ЕГН, Google Analytics service account, Meta Pixel токен). Отделен от
# JWT_SECRET — смяната на единия не засяга другия. Генерирай: openssl rand -base64 48
# Смяна на ключа = ротация (виж deploy/README.md), НЕ просто нова стойност.
ENCRYPTION_KEY=change-me-separate-random-string
# Само по време на ротация: старият ключ, за да се четат още непрезаписаните записи.
# След `node dist/src/cli/reencrypt-secrets.js` се маха.
# ENCRYPTION_KEY_PREVIOUS=
# Вътрешен ключ за server-to-server заявки от фронтенда
INTERNAL_API_KEY=change-me-random-32-chars
# Имейл на платформения админ (уведомления за заявки за демо/контакт)
ADMIN_EMAIL=admin@example.com

# ---------- Файлове: Cloudflare R2 (S3 API) ----------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=cortanasoft
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret

# ---------- Имейли ----------
# Вариант А: SMTP (напр. AWS SES SMTP credentials, порт 465)
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="CortanaSoft <no-reply@cortanasoft.com>"
# Вариант Б: SES API (ако се ползва вместо SMTP)
# SES_REGION=eu-central-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_FROM=

# ---------- Push известия: Firebase Admin ----------
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project.iam.gserviceaccount.com
# Многоредов ключ — на един ред с \n вместо нови редове
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------- Cortana AI (по подразбиране; всяка фирма може да има свой ключ в Настройки > AI) ----------
ANTHROPIC_API_KEY=sk-ant-...

# ---------- Evrotrust (електронно подписване в Трудови досиета) ----------
# test | prod
EVROTRUST_ENV=test
EVROTRUST_VENDOR_NUMBER=your-vendor-number
EVROTRUST_CLIENT_ID=your-client-id
EVROTRUST_CLIENT_SECRET=your-client-secret
EVROTRUST_VENDOR_API_KEY=your-vendor-api-key
# Публичният ключ на Evrotrust WebSDK и НАШАТА RSA-4096 двойка (PEM, на един ред с \n)
EVROTRUST_WEBSDK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
EVROTRUST_OUR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
EVROTRUST_OUR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Публичният адрес на API-то, на който Evrotrust праща webhook-и
EVROTRUST_CALLBACK_HOST=https://api.cortanasoft.com
